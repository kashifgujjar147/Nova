@media(max-width:650px){
 .announcement{font-size:9px}
 .announcement-links{display:none}
 .header-main{min-height:68px}
 .logo{font-size:19px}
 .logo-mark{width:30px;height:30px}
 .header-actions{gap:11px}
 .login-link{font-size:11px}
 .hero-premium,.hero-content{min-height:560px}
 .hero-content{width:100%;padding:70px 7vw}
 .hero-overlay{background:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.25))}
 .hero-content h1{font-size:46px;letter-spacing:-2.5px}
 .hero-content p{font-size:14px}
 .hero-actions{align-items:flex-start;flex-direction:column;gap:16px}
 .trust-strip{grid-template-columns:1fr 1fr}
 .trust-strip>div{padding:15px 10px;justify-content:flex-start}
 .trust-strip b{font-size:10px}
 .trust-strip small{font-size:9px}
 .section,.page{padding:50px 5vw}
 .premium-head h2{font-size:25px}
 .category-grid{grid-template-columns:repeat(2,1fr)}
 .category-tile{min-height:190px}
 .grid{grid-template-columns:1fr 1fr;gap:10px}
 .card img{height:210px}
 .promo-grid{grid-template-columns:1fr}
 .video-feature{padding:25px}
 .video-copy h2{font-size:30px}
 .reseller-banner{margin:0 5vw 50px;padding:32px 25px;display:grid}
 .reseller-banner h2{font-size:28px}
 .footer-grid{grid-template-columns:1fr 1fr;gap:30px}
 .footer-brand{grid-column:1/-1}
 .footer-bottom{display:grid}
 .account-dropdown{right:-20px}
 .detail{grid-template-columns:1fr;gap:25px}
 .form-grid{grid-template-columns:1fr}
 .checkout{grid-template-columns:1fr}
 .admin-grid,.stats{grid-template-columns:1fr 1fr}
 .table-wrap{margin-left:-5vw;margin-right:-5vw}
}


/* ============================================================
   NOVACART PREMIUM PRODUCT CARD SYSTEM
   ============================================================ */

.product-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:22px;
  align-items:start;
}

.product-card{
  position:relative;
  min-width:0;
  background:#fff;
  border:1px solid #e8e5df;
  border-radius:16px;
  overflow:hidden;
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.product-card:hover{
  transform:translateY(-5px);
  border-color:#d9d5cd;
  box-shadow:0 18px 45px rgba(24,24,24,.10);
}

.product-media{
  position:relative;
  background:#f6f5f2;
  overflow:hidden;
}

.product-image-link{
  display:block;
  text-decoration:none;
}

.product-image-wrap{
  position:relative;
  width:100%;
  aspect-ratio:1 / 1;
  overflow:hidden;
  background:#f6f5f2;
}

.product-image-wrap img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  padding:18px;
  transition:
    transform .45s cubic-bezier(.2,.7,.2,1);
}

.product-card:hover .product-image-wrap img{
  transform:scale(1.045);
}

.product-badge{
  position:absolute;
  top:14px;
  left:14px;
  z-index:2;
  display:inline-flex;
  align-items:center;
  min-height:28px;
  padding:0 10px;
  border-radius:999px;
  background:#171717;
  color:#fff;
  font-size:10px;
  font-weight:800;
  letter-spacing:.4px;
}

.product-stock-badge{
  position:absolute;
  left:14px;
  bottom:14px;
  z-index:2;
  padding:6px 9px;
  border-radius:7px;
  background:rgba(255,255,255,.94);
  border:1px solid #e1ded7;
  color:#8b4a00;
  font-size:10px;
  font-weight:700;
}

.wishlist{
  position:absolute;
  top:14px;
  right:14px;
  z-index:5;
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid #e2dfd8;
  border-radius:50%;
  background:rgba(255,255,255,.94);
  color:#242424;
  font-size:21px;
  line-height:1;
  cursor:pointer;
  box-shadow:0 5px 16px rgba(0,0,0,.07);
  transition:
    background .2s ease,
    transform .2s ease,
    border-color .2s ease;
}

.wishlist:hover{
  transform:scale(1.06);
  background:#171717;
  border-color:#171717;
  color:#fff;
}

.product-copy{
  padding:17px 17px 15px;
}

.product-topline{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  min-height:17px;
}

.product-meta{
  overflow:hidden;
  color:#8a877f;
  font-size:10px;
  font-weight:800;
  letter-spacing:1.15px;
  line-height:1.2;
  text-transform:uppercase;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.product-gender{
  flex:0 0 auto;
  color:#aaa69d;
  font-size:9px;
  text-transform:capitalize;
}

.product-title-link{
  display:block;
  color:inherit;
  text-decoration:none;
}

.product-title-link h3{
  display:-webkit-box;
  min-height:44px;
  margin:8px 0 7px;
  overflow:hidden;
  font-size:15px;
  font-weight:700;
  line-height:1.45;
  letter-spacing:-.2px;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
}

.product-title-link:hover h3{
  text-decoration:underline;
  text-underline-offset:3px;
}

.rating-row{
  display:flex;
  align-items:center;
  gap:5px;
  min-height:17px;
  color:#6f6c65;
  font-size:11px;
}

.rating-stars{
  color:#171717;
  font-size:13px;
}

.rating-reviews{
  color:#aaa69f;
}

.product-card .price-row{
  display:flex;
  align-items:baseline;
  flex-wrap:wrap;
  gap:8px;
  margin-top:12px;
}

.product-card .price-row strong{
  color:#171717;
  font-size:17px;
  font-weight:800;
  letter-spacing:-.25px;
}

.product-card .price-row del{
  margin:0;
  color:#a4a19a;
  font-size:11px;
}

.product-foot{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-top:14px;
  padding-top:12px;
  border-top:1px solid #efede8;
}

.product-card .stock{
  font-size:10px;
  font-weight:700;
  color:#47704b;
}

.product-card .stock.low{
  color:#9a641e;
}

.product-card .stock.out{
  color:#a04747;
}

.product-card .view-link{
  display:inline-flex;
  align-items:center;
  gap:5px;
  color:#171717;
  font-size:10px;
  font-weight:800;
  text-decoration:none;
  white-space:nowrap;
}

.product-card .view-link span{
  transition:transform .2s ease;
}

.product-card:hover .view-link span{
  transform:translateX(3px);
}

.catalog-subtitle{
  margin:8px 0 0;
  color:#77736b;
  font-size:13px;
  line-height:1.6;
}

.products-page .section-head{
  margin-bottom:28px;
}

.products-page .filter-panel{
  margin-bottom:30px;
}

/* Keep old generic cards from affecting ProductCard */
.product-grid .card{
  all:unset;
}

@media(max-width:1150px){
  .product-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:18px;
  }
}

@media(max-width:900px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:15px;
  }

  .product-copy{
    padding:15px;
  }

  .product-title-link h3{
    font-size:14px;
  }
}

@media(max-width:600px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
  }

  .product-card{
    border-radius:12px;
  }

  .product-image-wrap img{
    padding:10px;
  }

  .product-badge{
    top:9px;
    left:9px;
    min-height:24px;
    padding:0 7px;
    font-size:9px;
  }

  .product-stock-badge{
    left:9px;
    bottom:9px;
    padding:5px 7px;
    font-size:8px;
  }

  .wishlist{
    top:9px;
    right:9px;
    width:32px;
    height:32px;
    font-size:18px;
  }

  .product-copy{
    padding:12px;
  }

  .product-meta{
    font-size:8px;
    letter-spacing:.8px;
  }

  .product-title-link h3{
    min-height:40px;
    margin:6px 0;
    font-size:12px;
    line-height:1.4;
  }

  .rating-row{
    font-size:9px;
  }

  .rating-stars{
    font-size:11px;
  }

  .product-card .price-row{
    margin-top:9px;
    gap:5px;
  }

  .product-card .price-row strong{
    font-size:13px;
  }

  .product-card .price-row del{
    font-size:9px;
  }

  .product-foot{
    margin-top:10px;
    padding-top:9px;
  }

  .product-card .stock,
  .product-card .view-link{
    font-size:8px;
  }

  .product-gender{
    display:none;
  }
}
