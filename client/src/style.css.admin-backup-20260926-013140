:root{
 font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 color:#171717;
 background:#fafaf8;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#fafaf8;color:#171717}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font:inherit}
button{cursor:pointer}

.site-shell{min-height:100vh;background:#fafaf8}
.announcement{
 min-height:32px;
 padding:6px 5%;
 display:flex;
 align-items:center;
 justify-content:center;
 gap:20px;
 background:#171717;
 color:#fff;
 font-size:11px;
 letter-spacing:.15px
}
.announcement-links{
 position:absolute;
 right:5%;
 display:flex;
 gap:18px
}
.announcement a{opacity:.78}
.announcement a:hover{opacity:1}

.site-header{
 position:sticky;
 top:0;
 z-index:50;
 background:#fff;
 border-bottom:1px solid #e8e8e8
}

.header-main{
 min-height:72px;
 padding:0 5%;
 display:flex;
 align-items:center;
 gap:26px
}

.header-inner{
 display:flex;
 align-items:center;
 width:100%;
 gap:26px
}

.logo{
 display:flex;
 align-items:center;
 gap:9px;
 font-size:21px;
 font-weight:800;
 letter-spacing:-.7px;
 white-space:nowrap
}

.logo img{
 max-height:38px;
 max-width:145px;
 object-fit:contain
}

.logo-mark{
 width:32px;
 height:32px;
 border:1px solid #171717;
 display:grid;
 place-items:center;
 font-size:13px;
 font-weight:800
}

.main-nav{
 display:flex;
 align-items:center;
 gap:22px;
 white-space:nowrap;
 margin-left:4px
}

.main-nav a{
 position:relative;
 padding:26px 0;
 color:#555;
 font-size:13px;
 font-weight:600;
 transition:color .2s ease
}

.main-nav a:hover{
 color:#111
}

.main-nav a:after{
 content:"";
 position:absolute;
 left:50%;
 right:50%;
 bottom:18px;
 height:1px;
 background:#171717;
 transition:.2s ease
}

.main-nav a:hover:after{
 left:0;
 right:0
}

.nav-offers{
 color:#171717!important;
 font-weight:750!important
}

.header-search{
 height:40px;
 min-width:180px;
 flex:1;
 max-width:330px;
 display:flex;
 align-items:center;
 gap:8px;
 border:1px solid #dedede;
 background:#fafafa;
 padding:0 12px;
 transition:border-color .2s,background .2s
}

.header-search:focus-within{
 border-color:#aaa;
 background:#fff
}

.header-search span{
 font-size:20px;
 line-height:1;
 color:#777
}

.header-search input{
 width:100%;
 border:0;
 outline:0;
 background:transparent;
 font-size:12px;
 color:#222
}

.header-search input::placeholder{
 color:#999
}

.header-actions{
 display:flex;
 align-items:center;
 gap:15px;
 margin-left:auto
}

.icon-action{
 position:relative;
 width:34px;
 height:34px;
 display:grid;
 place-items:center;
 font-size:17px;
 color:#333
}

.icon-action:hover{
 color:#000
}

.icon-action b{
 position:absolute;
 top:0;
 right:-2px;
 min-width:15px;
 height:15px;
 padding:0 4px;
 border-radius:50%;
 background:#171717;
 color:#fff;
 font-size:8px;
 display:grid;
 place-items:center
}

.account-wrap{
 position:relative;
 height:72px;
 display:flex;
 align-items:center
}

.account-action{
 display:flex;
 align-items:center;
 gap:6px;
 font-size:12px;
 font-weight:650;
 color:#333
}

.account-icon{
 font-size:20px
}

.account-label{
 white-space:nowrap
}

.login-link{
 font-size:12px;
 font-weight:700
}

.account-dropdown{
 position:absolute;
 right:0;
 top:64px;
 width:190px;
 padding:7px;
 background:#fff;
 border:1px solid #e4e4e4;
 box-shadow:0 12px 35px rgba(0,0,0,.08);
 display:none
}

.account-wrap:hover .account-dropdown{
 display:grid
}

.account-dropdown a,
.account-dropdown button{
 padding:10px 11px;
 border:0;
 background:none;
 text-align:left;
 font-size:12px;
 color:#333
}

.account-dropdown a:hover,
.account-dropdown button:hover{
 background:#f6f6f4
}

.admin-dropdown-link{
 font-weight:800!important;
 border-top:1px solid #eee!important;
 margin-top:3px
}

.mobile-menu-button,
.mobile-search{
 display:none
}

@media(max-width:1150px){
 .header-main{
  gap:18px
 }

 .header-inner{
  gap:18px
 }

 .main-nav{
  gap:15px
 }

 .main-nav a{
  font-size:12px
 }

 .header-search{
  max-width:270px;
  min-width:150px
 }
}

@media(max-width:900px){
 .announcement{
  padding-left:4vw;
  padding-right:4vw
 }

 .announcement-links{
  display:none
 }

 .header-main{
  min-height:68px;
  padding:0 4vw
 }

 .header-inner{
  gap:12px
 }

 .mobile-menu-button{
  display:flex;
  flex:0 0 34px;
  width:34px;
  height:34px;
  border:0;
  background:transparent;
  flex-direction:column;
  justify-content:center;
  gap:5px;
  padding:6px
 }

 .mobile-menu-button span{
  display:block;
  width:20px;
  height:1px;
  background:#171717
 }

 .main-nav{
  position:absolute;
  left:0;
  right:0;
  top:68px;
  background:#fff;
  border-bottom:1px solid #ddd;
  padding:10px 5vw 15px;
  display:none;
  flex-direction:column;
  align-items:flex-start;
  gap:0;
  box-shadow:0 10px 25px rgba(0,0,0,.05)
 }

 .main-nav.open{
  display:flex
 }

 .main-nav a{
  width:100%;
  padding:13px 0;
  border-bottom:1px solid #f0f0f0
 }

 .main-nav a:after{
  display:none
 }

 .header-search{
  display:none
 }

 .mobile-search{
  display:block;
  padding:0 4vw 12px
 }

 .mobile-search .header-search{
  display:flex;
  max-width:none;
  width:100%
 }

 .account-label{
  display:none
 }

 .logo{
  font-size:19px
 }

 .logo-mark{
  width:30px;
  height:30px
 }

 .header-actions{
  gap:8px
 }
}

@media(max-width:650px){
 .announcement{
  min-height:29px;
  font-size:9px
 }

 .header-main{
  min-height:64px
 }

 .main-nav{
  top:64px
 }

 .logo{
  font-size:18px
 }

 .header-actions{
  gap:5px
 }

 .icon-action{
  width:31px;
  height:31px
 }

 .login-link{
  font-size:10px
 }

 .account-dropdown{
  right:-20px
 }
}
.hero-premium{
 position:relative;min-height:620px;overflow:hidden;background:#dedbd2
}
.hero-premium>img{
 position:absolute;inset:0;width:100%;height:100%;object-fit:cover
}
.hero-overlay{
 position:absolute;inset:0;
 background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.16) 65%,rgba(0,0,0,.02))
}
.hero-content{
 position:relative;z-index:2;min-height:620px;
 width:min(760px,72%);padding:110px 0 90px 8vw;
 color:#fff;display:flex;flex-direction:column;justify-content:center
}
.hero-content h1{
 font-size:clamp(46px,6vw,82px);line-height:.95;
 letter-spacing:-4px;margin:17px 0 22px;font-weight:750
}
.hero-content em{font-family:Georgia,serif;font-weight:400}
.hero-content p{max-width:540px;font-size:17px;line-height:1.7;color:rgba(255,255,255,.82);margin:0 0 14px}
.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;color:#777}
.hero-content .eyebrow{color:rgba(255,255,255,.72)}
.hero-actions{display:flex;align-items:center;gap:24px;margin-top:18px}
.hero-btn{background:#fff!important;color:#171717!important}
.hero-text-link{font-size:13px;font-weight:700;border-bottom:1px solid rgba(255,255,255,.6);padding-bottom:4px}
.hero-dots{position:absolute;z-index:4;left:8vw;bottom:38px;display:flex;gap:7px}
.hero-dots button{width:28px;height:2px;border:0;background:rgba(255,255,255,.45);padding:0}
.hero-dots button.active{background:#fff;width:45px}

.btn{
 display:inline-flex;align-items:center;justify-content:center;gap:10px;
 min-height:44px;padding:0 20px;border:1px solid #171717;
 background:#171717;color:#fff;font-size:12px;font-weight:750;
 transition:.2s
}
.btn:hover{transform:translateY(-1px);opacity:.9}
.btn.ghost{background:#fff;color:#171717}
.trust-strip{
 display:grid;grid-template-columns:repeat(4,1fr);
 border-bottom:1px solid #e5e3dd;background:#fff
}
.trust-strip>div{
 min-height:90px;padding:18px 30px;display:flex;align-items:center;justify-content:center;
 gap:12px;border-right:1px solid #e9e7e1
}
.trust-strip>div:last-child{border-right:0}
.trust-strip strong{font-size:18px;font-weight:500}
.trust-strip span{display:grid;gap:2px}
.trust-strip b{font-size:12px}
.trust-strip small{font-size:10px;color:#888}

.section,.page{padding:80px 7vw;min-height:55vh}
.home-section{min-height:auto}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}
.premium-head h2{font-size:30px;letter-spacing:-1.3px;margin:7px 0 0}
.view-link{font-size:12px;font-weight:750;border-bottom:1px solid #aaa;padding-bottom:4px}
.view-link:hover{border-color:#171717}

.category-grid{
 display:grid;grid-template-columns:repeat(6,1fr);gap:12px
}
.category-tile{
 min-height:220px;position:relative;overflow:hidden;background:#e9e7e1;
 display:flex;flex-direction:column;justify-content:flex-end;padding:20px;color:#fff
}
.category-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.5s}
.category-tile:after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.7))}
.category-tile:hover img{transform:scale(1.04)}
.category-tile span,.category-tile small{position:relative;z-index:2}
.category-tile span{font-size:16px;font-weight:750}
.category-tile small{font-size:10px;margin-top:5px;opacity:.8}

.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.premium-product-grid .card{transition:.2s}
.premium-product-grid .card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.06)}
.card{background:#fff;border:1px solid #e7e4de;overflow:hidden}
.card img{width:100%;height:260px;object-fit:cover}
.card>div{padding:18px}
.card h3{margin:7px 0 10px}
.card del{color:#999;margin-left:8px}
.card p{color:#777;font-size:13px}

.promo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.promo-card{background:#fff;border:1px solid #e5e2db;overflow:hidden}
.promo-card img{width:100%;height:280px;object-fit:cover}
.promo-card>div{padding:22px}
.premium-promo h3{font-size:23px;letter-spacing:-.5px;margin:8px 0}
.premium-promo p{font-size:13px;color:#777;line-height:1.6}

.video-feature{
 display:grid;grid-template-columns:minmax(250px,.75fr) minmax(0,1.25fr);
 gap:40px;align-items:center;background:#eeeae2;padding:42px
}
.video-copy h2{font-size:38px;letter-spacing:-1.5px;margin:8px 0 15px}
.video-copy p{color:#666;line-height:1.7;margin-bottom:25px}
.featured-video{width:100%;max-height:520px;object-fit:cover;background:#111}

.reseller-banner{
 min-height:auto!important;background:#171717;color:#fff;
 display:flex;align-items:center;justify-content:space-between;gap:30px;
 margin:0 7vw 80px;padding:50px 55px
}
.reseller-banner h2{font-size:34px;letter-spacing:-1px;margin:8px 0}
.reseller-banner p{color:#aaa;margin:0}
.reseller-banner .eyebrow{color:#999}

.empty,.state,.error{padding:22px;background:#fff;border:1px solid #ddd;margin:18px 0}
.error{color:#9b1c1c;border-color:#e4b5b5}

.site-footer{
 background:#171717;color:#fff;padding:65px 7vw 25px
}
.footer-grid{
 display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:50px;
 padding-bottom:50px
}
.footer-grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px}
.footer-brand p{color:#999;max-width:340px;line-height:1.6;font-size:13px}
.footer-logo{font-size:24px;font-weight:800;letter-spacing:-1px}
.footer-grid h4{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;margin:0 0 8px}
.footer-grid a{color:#aaa;font-size:12px}
.footer-grid a:hover{color:#fff}
.social-links{display:flex!important;flex-direction:row!important;flex-wrap:wrap;gap:8px!important;margin-top:8px}
.social-links a{border:1px solid #444;padding:7px 10px}
.footer-bottom{
 border-top:1px solid #333;padding-top:20px;
 display:flex;justify-content:space-between;gap:20px;
 color:#777;font-size:10px
}

.filters{display:flex;gap:10px;flex-wrap:wrap}
.filters input,.filters select,.checkout input,.checkout select,.admin-form input,.admin-form textarea,.admin-form select{padding:13px;border:1px solid #ccc;background:#fff;width:100%}
.pagination{display:flex;gap:6px;margin-top:24px}
.pagination button{border:1px solid #ccc;background:#fff;padding:8px 12px}
.pagination button.active{background:#171717;color:#fff}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
.cart-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:20px;background:#fff;border-bottom:1px solid #eee;padding:18px}
.qty{display:flex;gap:12px;align-items:center}
.qty button{width:34px;height:34px;border:1px solid #ccc;background:#fff}
.checkout{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:30px}
.checkout form{display:grid;gap:12px}
.checkout aside{height:max-content}
.review{padding:16px;margin-top:10px}
.address{padding:18px;margin-bottom:12px}
.timeline{border-left:2px solid #ccc;padding-left:20px;margin:20px 0}
.timeline>div{display:flex;justify-content:space-between;gap:20px;padding:12px 0}
.admin{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:30px}
.admin a{background:#fff;padding:22px;border:1px solid #e2dfd7;font-weight:800}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stats div{background:#fff;padding:20px;border:1px solid #e2dfd7;color:#666}
.stats strong{display:block;color:#111;font-size:24px;margin-top:8px}
.data{background:#171717;color:#eee;padding:22px;overflow:auto;max-height:500px;font-size:12px}
.detail{display:grid;grid-template-columns:1fr 1fr;gap:60px}
.detail>img{width:100%;max-height:650px;object-fit:cover}
.detail h1{font-size:54px;letter-spacing:-2px}
.narrow{max-width:720px;margin:auto}
.narrow form{display:grid;gap:14px}
.narrow input,.narrow select{padding:14px;border:1px solid #ccc;background:#fff}
.line{display:flex;justify-content:space-between;gap:15px;background:#fff;border-bottom:1px solid #eee;padding:18px}
.line button{border:0;background:none;text-decoration:underline}
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:15px}
.form-grid label{font-size:12px;font-weight:700;display:grid;gap:6px}
.check{display:flex!important;align-items:center;gap:8px}
.table-wrap{overflow:auto;background:#fff;border:1px solid #ddd}
.table-wrap table{width:100%;border-collapse:collapse;min-width:720px}
.table-wrap th,.table-wrap td{padding:14px;border-bottom:1px solid #eee;text-align:left;vertical-align:top}
.table-wrap small,.line small{display:block;color:#777;margin-top:4px}
.btn.small{padding:7px 10px;font-size:12px;margin:2px}
.hero-copy{background:#ebe9e2}
.detail>div:first-child img{display:block;width:100%;max-height:650px;object-fit:cover;margin-bottom:10px}
code{background:#f1f1f1;padding:3px 6px}
.admin-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.admin-link{text-align:left;padding:20px;cursor:pointer}
.admin-form{padding:24px;margin-bottom:28px}
.chart-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.chart-card{background:#fff;border:1px solid #ddd;padding:18px}
.bars{height:140px;display:flex;align-items:flex-end;gap:3px;margin-top:15px}
.bars i{flex:1;min-width:2px;background:#171717;display:block}
.promo-card>div{padding:20px}
.filter-panel{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:10px;background:#fff;border:1px solid #ddd;padding:16px;margin-bottom:28px}
.filter-panel input,.filter-panel select{padding:12px;border:1px solid #ccc;background:#fff;min-width:0}
.price-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.sale-badge{font-size:11px;font-weight:800;padding:4px 7px;border:1px solid #222}
.stock{font-weight:700}
.stock.out{color:#a11}
.product-media{min-width:0}
.gallery-main img{width:100%;max-height:650px;object-fit:cover}
.gallery-thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:10px}
.gallery-thumbs img{height:90px;object-fit:cover}
.product-video{margin-top:15px}
.product-video video{width:100%;max-height:500px}
.variant{padding:15px;margin-bottom:10px}
.nav-button{border:0;background:transparent;cursor:pointer;font-weight:700}

@media(max-width:1150px){
 .main-nav{gap:15px}
 .main-nav a{font-size:12px}
 .header-main{gap:18px}
 .category-grid{grid-template-columns:repeat(3,1fr)}
 .grid{grid-template-columns:repeat(3,1fr)}
 .footer-grid{grid-template-columns:2fr 1fr 1fr}
}
@media(max-width:900px){
 .announcement{padding-left:4vw;padding-right:4vw}
 .header-main{padding:0 4vw}
 .mobile-menu-button{
  display:flex;width:36px;height:36px;border:0;background:transparent;
  flex-direction:column;justify-content:center;gap:5px;padding:6px
 }
 .mobile-menu-button span{display:block;width:20px;height:1px;background:#171717}
 .main-nav{
  position:absolute;left:0;right:0;top:76px;
  background:#fff;border-bottom:1px solid #ddd;
  padding:15px 5vw;display:none;flex-direction:column;align-items:flex-start;gap:0
 }
 .main-nav.open{display:flex}
