/* =========================================================
   NOVACART — PREMIUM BANNER / PROMO SYSTEM
   Banner = one visible hero slide
   Promo Images = separate normal-flow section
   ========================================================= */

.premium-hero{
  position:relative;
  width:100%;
  margin:0;
  padding:0;
  overflow:hidden;
  isolation:isolate;
}

.hero-slider{
  position:relative;
  width:100%;
  height:clamp(420px,58vw,700px);
  min-height:420px;
  overflow:hidden;
  background:#08111f;
}

.hero-slide{
  position:absolute;
  inset:0;
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .65s ease,visibility .65s ease;
}

.hero-slide.is-active{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  z-index:2;
}

.hero-slide-image{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center;
}

.hero-slide-overlay{
  position:absolute;
  inset:0;
  z-index:1;
  background:
    linear-gradient(90deg,
      rgba(3,9,18,.86) 0%,
      rgba(3,9,18,.62) 36%,
      rgba(3,9,18,.18) 72%,
      rgba(3,9,18,.08) 100%);
}

.hero-content{
  position:relative;
  z-index:3;
  height:100%;
  width:min(1180px,90%);
  margin:auto;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
  color:#fff;
  padding:70px 0;
}

.hero-content h1{
  max-width:720px;
  margin:12px 0 18px;
  font-size:clamp(38px,5vw,72px);
  line-height:.98;
  letter-spacing:-.045em;
  color:#fff;
  text-shadow:0 8px 30px rgba(0,0,0,.28);
}

.hero-content p{
  max-width:600px;
  margin:0 0 28px;
  color:rgba(255,255,255,.84);
  font-size:clamp(15px,1.6vw,20px);
  line-height:1.65;
}

.hero-actions{
  display:flex;
  gap:12px;
}

.hero-btn{
  display:inline-flex;
  align-items:center;
  gap:12px;
  min-height:52px;
  padding:0 24px;
  border-radius:999px;
  background:#fff;
  color:#07101d;
  box-shadow:0 12px 35px rgba(0,0,0,.25);
}

.hero-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 16px 42px rgba(0,0,0,.34);
}

.hero-arrow{
  position:absolute;
  top:50%;
  z-index:5;
  width:48px;
  height:48px;
  transform:translateY(-50%);
  border:1px solid rgba(255,255,255,.3);
  border-radius:50%;
  background:rgba(4,12,24,.36);
  backdrop-filter:blur(12px);
  color:#fff;
  font-size:30px;
  line-height:1;
  cursor:pointer;
  transition:.2s ease;
}

.hero-arrow:hover{
  background:rgba(255,255,255,.16);
  border-color:rgba(255,255,255,.65);
}

.hero-arrow-prev{left:28px}
.hero-arrow-next{right:28px}

.hero-dots{
  position:absolute;
  z-index:6;
  left:50%;
  bottom:24px;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  gap:8px;
}

.hero-dots button{
  width:8px;
  height:8px;
  padding:0;
  border:0;
  border-radius:99px;
  background:rgba(255,255,255,.45);
  cursor:pointer;
  transition:.25s ease;
}

.hero-dots button.active{
  width:28px;
  background:#fff;
}

.hero-empty{
  min-height:420px;
  display:flex;
  align-items:center;
  background:
    radial-gradient(circle at 80% 20%,rgba(37,99,235,.22),transparent 35%),
    linear-gradient(135deg,#07111f,#12243d);
  color:#fff;
}

.hero-empty>div{
  width:min(1180px,90%);
  margin:auto;
}

.hero-empty h1{
  max-width:700px;
  margin:10px 0;
  color:#fff;
  font-size:clamp(38px,5vw,68px);
  line-height:1;
}

.hero-empty p{
  color:rgba(255,255,255,.75);
