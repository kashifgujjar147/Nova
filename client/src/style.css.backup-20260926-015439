@media(max-width:650px){
 .announcement{font-size:9px}
 .announcement-links{display:none}
 .header-main{min-height:68px}
 .logo{font-size:19px}
 .logo-mark{width:30px;height:30px}
 .header-actions{gap:11px}
 .login-link{font-size:11px}
 .hero-premium,.hero-content{min-height:560px}
 .hero-content{width:100%;padding:70px 7vw}
 .hero-overlay{background:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.25))}
 .hero-content h1{font-size:46px;letter-spacing:-2.5px}
 .hero-content p{font-size:14px}
 .hero-actions{align-items:flex-start;flex-direction:column;gap:16px}
 .trust-strip{grid-template-columns:1fr 1fr}
 .trust-strip>div{padding:15px 10px;justify-content:flex-start}
 .trust-strip b{font-size:10px}
 .trust-strip small{font-size:9px}
 .section,.page{padding:50px 5vw}
 .premium-head h2{font-size:25px}
 .category-grid{grid-template-columns:repeat(2,1fr)}
 .category-tile{min-height:190px}
 .grid{grid-template-columns:1fr 1fr;gap:10px}
 .card img{height:210px}
 .promo-grid{grid-template-columns:1fr}
 .video-feature{padding:25px}
 .video-copy h2{font-size:30px}
 .reseller-banner{margin:0 5vw 50px;padding:32px 25px;display:grid}
 .reseller-banner h2{font-size:28px}
 .footer-grid{grid-template-columns:1fr 1fr;gap:30px}
 .footer-brand{grid-column:1/-1}
 .footer-bottom{display:grid}
 .account-dropdown{right:-20px}
 .detail{grid-template-columns:1fr;gap:25px}
 .form-grid{grid-template-columns:1fr}
 .checkout{grid-template-columns:1fr}
 .admin-grid,.stats{grid-template-columns:1fr 1fr}
 .table-wrap{margin-left:-5vw;margin-right:-5vw}
}


/* ============================================================
   NOVACART PREMIUM PRODUCT CARD SYSTEM
   ============================================================ */

.product-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:22px;
  align-items:start;
}

.product-card{
  position:relative;
  min-width:0;
  background:#fff;
  border:1px solid #e8e5df;
  border-radius:16px;
  overflow:hidden;
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.product-card:hover{
  transform:translateY(-5px);
  border-color:#d9d5cd;
  box-shadow:0 18px 45px rgba(24,24,24,.10);
}

.product-media{
  position:relative;
  background:#f6f5f2;
  overflow:hidden;
}

.product-image-link{
  display:block;
  text-decoration:none;
}

.product-image-wrap{
  position:relative;
  width:100%;
  aspect-ratio:1 / 1;
  overflow:hidden;
  background:#f6f5f2;
}

.product-image-wrap img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  padding:18px;
  transition:
    transform .45s cubic-bezier(.2,.7,.2,1);
}

.product-card:hover .product-image-wrap img{
  transform:scale(1.045);
}

.product-badge{
  position:absolute;
  top:14px;
  left:14px;
  z-index:2;
  display:inline-flex;
  align-items:center;
  min-height:28px;
  padding:0 10px;
  border-radius:999px;
  background:#171717;
  color:#fff;
  font-size:10px;
  font-weight:800;
  letter-spacing:.4px;
}

.product-stock-badge{
  position:absolute;
  left:14px;
  bottom:14px;
  z-index:2;
  padding:6px 9px;
  border-radius:7px;
  background:rgba(255,255,255,.94);
  border:1px solid #e1ded7;
  color:#8b4a00;
  font-size:10px;
  font-weight:700;
}

.wishlist{
  position:absolute;
  top:14px;
  right:14px;
  z-index:5;
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid #e2dfd8;
  border-radius:50%;
  background:rgba(255,255,255,.94);
  color:#242424;
  font-size:21px;
  line-height:1;
  cursor:pointer;
  box-shadow:0 5px 16px rgba(0,0,0,.07);
  transition:
    background .2s ease,
    transform .2s ease,
    border-color .2s ease;
}

.wishlist:hover{
  transform:scale(1.06);
  background:#171717;
  border-color:#171717;
  color:#fff;
}

.product-copy{
  padding:17px 17px 15px;
}

.product-topline{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  min-height:17px;
}

.product-meta{
  overflow:hidden;
  color:#8a877f;
  font-size:10px;
  font-weight:800;
  letter-spacing:1.15px;
  line-height:1.2;
  text-transform:uppercase;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.product-gender{
  flex:0 0 auto;
  color:#aaa69d;
  font-size:9px;
  text-transform:capitalize;
}

.product-title-link{
  display:block;
  color:inherit;
  text-decoration:none;
}

.product-title-link h3{
  display:-webkit-box;
  min-height:44px;
  margin:8px 0 7px;
  overflow:hidden;
  font-size:15px;
  font-weight:700;
  line-height:1.45;
  letter-spacing:-.2px;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
}

.product-title-link:hover h3{
  text-decoration:underline;
  text-underline-offset:3px;
}

.rating-row{
  display:flex;
  align-items:center;
  gap:5px;
  min-height:17px;
  color:#6f6c65;
  font-size:11px;
}

.rating-stars{
  color:#171717;
  font-size:13px;
}

.rating-reviews{
  color:#aaa69f;
}

.product-card .price-row{
  display:flex;
  align-items:baseline;
  flex-wrap:wrap;
  gap:8px;
  margin-top:12px;
}

.product-card .price-row strong{
  color:#171717;
  font-size:17px;
  font-weight:800;
  letter-spacing:-.25px;
}

.product-card .price-row del{
  margin:0;
  color:#a4a19a;
  font-size:11px;
}

.product-foot{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-top:14px;
  padding-top:12px;
  border-top:1px solid #efede8;
}

.product-card .stock{
  font-size:10px;
  font-weight:700;
  color:#47704b;
}

.product-card .stock.low{
  color:#9a641e;
}

.product-card .stock.out{
  color:#a04747;
}

.product-card .view-link{
  display:inline-flex;
  align-items:center;
  gap:5px;
  color:#171717;
  font-size:10px;
  font-weight:800;
  text-decoration:none;
  white-space:nowrap;
}

.product-card .view-link span{
  transition:transform .2s ease;
}

.product-card:hover .view-link span{
  transform:translateX(3px);
}

.catalog-subtitle{
  margin:8px 0 0;
  color:#77736b;
  font-size:13px;
  line-height:1.6;
}

.products-page .section-head{
  margin-bottom:28px;
}

.products-page .filter-panel{
  margin-bottom:30px;
}

/* Keep old generic cards from affecting ProductCard */
.product-grid .card{
  all:unset;
}

@media(max-width:1150px){
  .product-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:18px;
  }
}

@media(max-width:900px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:15px;
  }

  .product-copy{
    padding:15px;
  }

  .product-title-link h3{
    font-size:14px;
  }
}

@media(max-width:600px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
  }

  .product-card{
    border-radius:12px;
  }

  .product-image-wrap img{
    padding:10px;
  }

  .product-badge{
    top:9px;
    left:9px;
    min-height:24px;
    padding:0 7px;
    font-size:9px;
  }

  .product-stock-badge{
    left:9px;
    bottom:9px;
    padding:5px 7px;
    font-size:8px;
  }

  .wishlist{
    top:9px;
    right:9px;
    width:32px;
    height:32px;
    font-size:18px;
  }

  .product-copy{
    padding:12px;
  }

  .product-meta{
    font-size:8px;
    letter-spacing:.8px;
  }

  .product-title-link h3{
    min-height:40px;
    margin:6px 0;
    font-size:12px;
    line-height:1.4;
  }

  .rating-row{
    font-size:9px;
  }

  .rating-stars{
    font-size:11px;
  }

  .product-card .price-row{
    margin-top:9px;
    gap:5px;
  }

  .product-card .price-row strong{
    font-size:13px;
  }

  .product-card .price-row del{
    font-size:9px;
  }

  .product-foot{
    margin-top:10px;
    padding-top:9px;
  }

  .product-card .stock,
  .product-card .view-link{
    font-size:8px;
  }

  .product-gender{
    display:none;
  }
}

/* =========================================================
   NOVACART ADMIN OS
   Dashboard / Sidebar / Workspace UI
   ========================================================= */

.admin-shell{
  min-height:100vh;
  display:grid;
  grid-template-columns:260px minmax(0,1fr);
  background:#f4f5f7;
  color:#171717;
}

/* ---------- SIDEBAR ---------- */

.admin-sidebar{
  position:sticky;
  top:0;
  height:100vh;
  overflow-y:auto;
  background:#111315;
  color:#fff;
  border-right:1px solid #25282b;
  padding:22px 14px 18px;
  display:flex;
  flex-direction:column;
  z-index:100;
}

.admin-brand{
  padding:4px 8px 22px;
  border-bottom:1px solid #292d31;
  margin-bottom:18px;
}

.admin-brand a{
  display:flex;
  align-items:center;
  gap:10px;
  color:#fff;
  font-weight:800;
  letter-spacing:-.4px;
}

.admin-logo{
  width:36px;
  height:36px;
  display:grid;
  place-items:center;
  border:1px solid #555b61;
  border-radius:10px;
  background:#1b1f23;
  font-size:17px;
}

.admin-brand small{
  display:block;
  margin-top:2px;
  color:#8e969e;
  font-size:10px;
  font-weight:600;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.admin-label{
  padding:0 10px 9px;
  color:#737b84;
  font-size:10px;
  font-weight:800;
  letter-spacing:.14em;
  text-transform:uppercase;
}

.admin-sidebar nav{
  display:flex;
  flex-direction:column;
  gap:3px;
}

.admin-sidebar nav a{
  min-height:40px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:9px 10px;
  border:1px solid transparent;
  border-radius:9px;
  color:#aeb5bc;
  font-size:13px;
  font-weight:650;
  transition:background .18s ease,color .18s ease,border-color .18s ease;
}

.admin-sidebar nav a:hover{
  color:#fff;
  background:#1b1f23;
  border-color:#292e33;
}

.admin-sidebar nav a.active{
  color:#fff;
  background:#272c31;
  border-color:#3a4148;
  box-shadow:inset 3px 0 0 #fff;
}

.nav-dot{
  width:25px;
  height:25px;
  flex:0 0 25px;
  display:grid;
  place-items:center;
  border-radius:7px;
  background:#20252a;
  color:#cfd4d9;
  font-size:10px;
  font-weight:800;
}

.admin-sidebar nav a.active .nav-dot{
  background:#fff;
  color:#171717;
}

.admin-storefront{
  margin-top:auto;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  min-height:42px;
  padding:10px 12px;
  border:1px solid #343a40;
  border-radius:9px;
  color:#e5e8eb;
  font-size:12px;
  font-weight:750;
  background:#181c20;
}

.admin-storefront:hover{
  background:#22272c;
  color:#fff;
}

/* ---------- MAIN CONTENT ---------- */

.admin-content{
  min-width:0;
  min-height:100vh;
  background:#f4f5f7;
}

.admin-mobile-bar{
  display:none;
}

.admin-page{
  width:100%;
  max-width:1500px;
  margin:0 auto;
  padding:34px 38px 50px;
}

.admin-topbar{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:24px;
  margin-bottom:26px;
}

.admin-topbar h1{
  margin:5px 0 7px;
  font-size:32px;
  line-height:1.05;
  letter-spacing:-1.2px;
}

.admin-topbar p{
  margin:0;
  color:#737980;
  font-size:14px;
}

.eyebrow{
  color:#777e85;
  font-size:10px;
  font-weight:850;
  letter-spacing:.16em;
  text-transform:uppercase;
}

.admin-actions{
  display:flex;
  align-items:center;
  gap:9px;
}

.btn{
  min-height:40px;
  padding:9px 15px;
  border:1px solid #171717;
  border-radius:8px;
  background:#171717;
  color:#fff;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
}

.btn:hover{
  background:#303030;
}

.btn.ghost{
  border-color:#d7dade;
  background:#fff;
  color:#25282b;
}

.btn.ghost:hover{
  background:#f0f1f2;
}

.error{
  margin-bottom:18px;
  padding:13px 15px;
  border:1px solid #e7bcbc;
  border-radius:9px;
  background:#fff5f5;
  color:#a32929;
  font-size:13px;
}

/* ---------- STATS ---------- */

.admin-stat-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
  margin-bottom:18px;
}

.admin-stat{
  min-width:0;
  padding:19px 20px;
  border:1px solid #e0e3e6;
  border-radius:12px;
  background:#fff;
  box-shadow:0 2px 8px rgba(20,24,28,.035);
}

.admin-stat span{
  display:block;
  color:#777e85;
  font-size:11px;
  font-weight:750;
  text-transform:capitalize;
}

.admin-stat strong{
  display:block;
  margin-top:8px;
  color:#151719;
  font-size:25px;
  line-height:1.1;
  letter-spacing:-.7px;
}

.admin-stat small{
  display:block;
  margin-top:8px;
  color:#9aa0a6;
  font-size:10px;
}

/* ---------- PANELS ---------- */

.admin-overview{
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(330px,.85fr);
  gap:18px;
}

.admin-panel{
  min-width:0;
  padding:22px;
  border:1px solid #e0e3e6;
  border-radius:13px;
  background:#fff;
  box-shadow:0 2px 10px rgba(20,24,28,.035);
}

.panel-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:15px;
  margin-bottom:18px;
}

.panel-head h2{
  margin:5px 0 0;
  font-size:19px;
  letter-spacing:-.45px;
}

.muted{
  color:#8b9299;
  font-size:11px;
  font-weight:650;
}

/* ---------- QUICK MODULES ---------- */

.admin-module-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:9px;
}

.admin-module-card{
  width:100%;
  min-width:0;
  display:grid;
  grid-template-columns:34px minmax(0,1fr) 18px;
  align-items:center;
  gap:10px;
  padding:12px;
  border:1px solid #e3e5e7;
  border-radius:9px;
  background:#fafafa;
  color:#171717;
  text-align:left;
  cursor:pointer;
  transition:transform .15s ease,background .15s ease,border-color .15s ease,box-shadow .15s ease;
}

.admin-module-card:hover{
  transform:translateY(-1px);
  border-color:#c7cbd0;
  background:#fff;
  box-shadow:0 5px 14px rgba(20,24,28,.07);
}

.module-icon{
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:#171717;
  color:#fff;
  font-size:11px;
  font-weight:850;
}

.admin-module-card > span:nth-child(2){
  min-width:0;
}

.admin-module-card strong{
  display:block;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:12px;
  font-weight:800;
}

.admin-module-card small{
  display:block;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  margin-top:3px;
  color:#858c93;
  font-size:10px;
}

.admin-module-card > b{
  color:#8b9299;
  font-size:13px;
}

/* ---------- SNAPSHOT / CHART ---------- */

.mini-chart{
  position:relative;
  height:215px;
  overflow:hidden;
  border:1px solid #e8eaec;
  border-radius:10px;
  background:#fafafa;
}

.chart-lines{
  position:absolute;
  inset:18px 16px 24px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.chart-lines i{
  display:block;
  width:100%;
  height:1px;
  background:#e5e7e9;
}

.chart-bars{
  position:absolute;
  inset:20px 18px 24px;
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:7px;
}

.chart-bars span{
  flex:1;
  min-width:5px;
  max-width:24px;
  border-radius:4px 4px 0 0;
  background:#202326;
  opacity:.9;
}

.chart-caption{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:12px;
  color:#7b8289;
  font-size:11px;
}

.chart-caption b{
  color:#25282b;
  font-size:10px;
  font-weight:800;
}

.admin-note{
  display:flex;
  gap:11px;
  margin-top:17px;
  padding:13px;
  border:1px solid #e4e7e9;
  border-radius:9px;
  background:#fafafa;
}

.admin-note > span{
  width:25px;
  height:25px;
  flex:0 0 25px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#171717;
  color:#fff;
  font-size:11px;
  font-weight:900;
}

.admin-note strong{
  display:block;
  font-size:11px;
}

.admin-note p{
  margin:4px 0 0;
  color:#80878e;
  font-size:10px;
  line-height:1.5;
}

/* ---------- MOBILE ---------- */

@media (max-width:1100px){
  .admin-shell{
    grid-template-columns:220px minmax(0,1fr);
  }

  .admin-page{
    padding:28px 24px 42px;
  }

  .admin-stat-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .admin-overview{
    grid-template-columns:1fr;
  }
}

@media (max-width:760px){
  .admin-shell{
    display:block;
  }

  .admin-sidebar{
    display:none;
  }

  .admin-content{
    min-height:100vh;
  }

  .admin-mobile-bar{
    min-height:58px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:0 16px;
    background:#111315;
    color:#fff;
  }

  .admin-mobile-bar a{
    color:#fff;
    font-size:12px;
  }

  .admin-page{
    padding:22px 15px 35px;
  }

  .admin-topbar{
    align-items:flex-start;
    flex-direction:column;
    gap:16px;
  }

  .admin-topbar h1{
    font-size:27px;
  }

  .admin-actions{
    width:100%;
  }

  .admin-actions .btn{
    flex:1;
  }

  .admin-stat-grid{
    grid-template-columns:1fr 1fr;
    gap:9px;
  }

  .admin-stat{
    padding:15px;
  }

  .admin-stat strong{
    font-size:20px;
  }

  .admin-panel{
    padding:16px;
  }

  .admin-module-grid{
    grid-template-columns:1fr;
  }
}

@media (max-width:480px){
  .admin-stat-grid{
    grid-template-columns:1fr;
  }

  .admin-stat{
    display:grid;
    grid-template-columns:1fr auto;
    gap:4px 10px;
    align-items:center;
  }

  .admin-stat strong{
    grid-column:2;
    grid-row:1 / span 2;
    margin:0;
  }

  .admin-stat small{
    grid-column:1;
    margin:0;
  }

  .panel-head{
    align-items:flex-start;
  }

  .mini-chart{
    height:180px;
  }
}

