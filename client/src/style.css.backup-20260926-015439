/* PROMO — always below hero, never overlaying it */
.promo-section{
  position:relative;
  z-index:1;
  clear:both;
  overflow:visible;
}

.premium-promo-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:20px;
  align-items:stretch;
}

.premium-promo-card{
  position:relative;
  min-height:270px;
  display:block;
  overflow:hidden;
  border-radius:24px;
  background:#0b1524;
  box-shadow:0 18px 45px rgba(10,20,35,.12);
  isolation:isolate;
  transition:transform .3s ease,box-shadow .3s ease;
}

.premium-promo-card:hover{
  transform:translateY(-6px);
  box-shadow:0 25px 55px rgba(10,20,35,.2);
}

.promo-card-image{
  position:absolute;
  inset:0;
}

.promo-card-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .55s ease;
}

.premium-promo-card:hover .promo-card-image img{
  transform:scale(1.055);
}

.promo-card-shade{
  position:absolute;
  inset:0;
  background:linear-gradient(
    180deg,
    rgba(4,10,18,.03) 20%,
    rgba(4,10,18,.82) 100%
  );
}

.promo-card-content{
  position:relative;
  z-index:2;
  min-height:270px;
  padding:28px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  color:#fff;
}

.promo-card-content h3{
  margin:0 0 7px;
  color:#fff;
  font-size:25px;
  line-height:1.1;
}

.promo-card-content p{
  max-width:420px;
  margin:0 0 12px;
  color:rgba(255,255,255,.78);
  line-height:1.5;
}

.promo-card-link{
  width:max-content;
  color:#fff;
  font-weight:800;
  font-size:13px;
}

@media(max-width:900px){
  .hero-slider{
    height:500px;
    min-height:500px;
  }

  .hero-content{
    width:82%;
  }

  .premium-promo-grid{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:650px){
  .hero-slider{
    height:470px;
    min-height:470px;
  }

  .hero-slide-image{
    object-position:center;
  }

  .hero-slide-overlay{
    background:
      linear-gradient(
        90deg,
        rgba(3,9,18,.82),
        rgba(3,9,18,.48)
      );
  }

  .hero-content{
    width:84%;
    padding:50px 0 70px;
  }

  .hero-content h1{
    font-size:39px;
    max-width:95%;
  }

  .hero-content p{
    font-size:14px;
    max-width:95%;
  }

  .hero-arrow{
    width:40px;
    height:40px;
    font-size:25px;
  }

  .hero-arrow-prev{left:12px}
  .hero-arrow-next{right:12px}

  .hero-dots{
    bottom:18px;
  }

  .premium-promo-grid{
    grid-template-columns:1fr;
    gap:14px;
  }

  .premium-promo-card,
  .promo-card-content{
    min-height:240px;
  }
}

/* =========================================================
