.premium-hero{
  position:relative;
  width:100%;
  margin:0;
  padding:0;
  overflow:hidden;
  isolation:isolate;
}

.hero-slider{
  position:relative;
  width:100%;
  height:clamp(420px,58vw,700px);
  min-height:420px;
  overflow:hidden;
  background:#08111f;
}

.hero-slide{
  position:absolute;
  inset:0;
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .65s ease,visibility .65s ease;
}

.hero-slide.is-active{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  z-index:2;
}

.hero-slide-image{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center;
}

.hero-slide-overlay{
  position:absolute;
  inset:0;
  z-index:1;
  background:linear-gradient(
    90deg,
    rgba(3,9,18,.86) 0%,
    rgba(3,9,18,.62) 36%,
    rgba(3,9,18,.18) 72%,
    rgba(3,9,18,.08) 100%
