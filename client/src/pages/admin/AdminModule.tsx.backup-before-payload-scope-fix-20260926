                <button
                  className="btn small"
                  onClick={()=>request("post","/payments/"+x._id+"/collect-cod").then(load).catch(e=>setErr(apiError(e)))}
                >
                  Collect COD
                </button>
              }

              {name==="commissions"&&x.status==="PENDING"&&
                <button className="btn small" onClick={()=>transition(x._id,"APPROVED")}>
                  Approve
                </button>
              }

              {name==="commissions"&&x.status==="APPROVED"&&
                <button className="btn small" onClick={()=>transition(x._id,"PAID")}>
                  Pay
                </button>
              }

              {name==="orders"&&x.status==="PAYMENT_APPROVED"&&
                <button className="btn small" onClick={()=>transition(x._id,"PROCESSING")}>
                  Process
                </button>
              }

              {name==="orders"&&["PROCESSING","PACKED","SHIPPED","IN_TRANSIT","DELIVERED"].includes(x.status)&&
                <select
                  onChange={e=>e.target.value&&transition(x._id,e.target.value)}
                  defaultValue=""
                >
                  <option value="">Update status</option>
                  {["PACKED","SHIPPED","IN_TRANSIT","DELIVERED","COMPLETED"].map(st=>
                    <option key={st} value={st}>{st}</option>
                  )}
                </select>
              }

              {name==="affiliates"&&
                <button
                  className="btn small"
                  onClick={()=>request("patch","/affiliates/admin/"+x._id,{active:!x.active}).then(load).catch(e=>setErr(apiError(e)))}
                >
                  {x.active?"Disable":"Enable"}
                </button>
              }
            </td>
          </tr>
        )}
      </tbody>
    </table>

    {!list.length&&
      <div className="empty">No records found.</div>
    }
  </section>
</main></AdminShell>;

}











