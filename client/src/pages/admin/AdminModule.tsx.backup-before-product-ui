return <AdminShell><main className="page"><div className="section-head"><div><Link to="/admin">← Admin</Link><h1>{name.replace(/-/g," ")}</h1></div><button className="btn ghost"onClick={load}>Refresh</button></div>{err&&<div className="error">{err}</div>}{endpoints[name]&&<section className="card admin-form"><h2>{editing?"Edit":"Create"} {name}</h2><div className="form-grid">{(fields[name]||[]).map(([f,l]:any)=><label key={f}><span>{l}</span><Input field={f}value={form[f]}onChange={v=>setForm({...form,[f]:v})}/>{["image","thumbnail","logo"].includes(f)&&<UploadButton onUploaded={u=>uploadTo(f,u)}/>} {f==="images"&&<UploadButton multiple onUploaded={u=>setForm((x:any)=>({...x,images:[...(Array.isArray(x.images)?x.images:[]),u]}))}/>} {f==="video"&&<UploadButton onUploaded={u=>uploadTo(f,u)}/>}</label>)}</div>{name==="products"&&<VariantManager variants={variants}onChange={setVariants}/>}<button className="btn"onClick={save}>{editing?"Save changes":"Create"}</button>{editing&&<button className="btn ghost"onClick={()=>{setEditing(null);setForm({active:true});setVariants([])}}>Cancel</button>}</section>}<section className="table-wrap"><table><thead><tr><th>Record</th><th>Status</th><th>Value</th><th>Actions</th></tr></thead><tbody>{list.map((x:any)=><tr key={x._id}><td><strong>{x.name||x.title||x.orderNumber||x.transactionId||x.code||x._id}</strong><small>{x.email||x.user?.email||x.description?.slice?.(0,100)}</small>{name==="delivery"&&<small>Recipient: {x.recipientName||"—"} • Confirmed: {x.recipientConfirmedAt?new Date(x.recipientConfirmedAt).toLocaleString():"No"}<br/>Delivery: {x.deliveryDate?new Date(x.deliveryDate).toLocaleDateString():"—"} • Notes: {x.notes||"—"}<br/>Proof: {x.proofUpload?"Uploaded":"—"} • Signature: {x.signatureUpload?"Uploaded":"—"}</small>}</td><td>{x.status||((x.active===true)?"ACTIVE":(x.active===false?"INACTIVE":""))}</td><td>{x.total!=null?money(x.total):x.amount!=null?money(x.amount):x.salePrice!=null?money(x.salePrice):x.commissionValue